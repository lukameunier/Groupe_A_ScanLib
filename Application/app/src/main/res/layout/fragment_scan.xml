<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background">

    <!-- Bandeau en haut -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/secondary_background"
        android:gravity="center"
        android:text="@string/scan_title"
        android:textColor="@color/secondary_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Vue principale de la caméra avec coins arrondis -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCameraXContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/focusIndicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/focus_ring"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/cardCameraXContainer"
            app:layout_constraintStart_toStartOf="@id/cardCameraXContainer"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bouton de capture -->
    <ImageButton
        android:id="@+id/captureButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/camera_shutter_ring"
        android:contentDescription="@string/capture_photo"
        android:scaleType="center"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="@id/cardCameraXContainer"
        app:layout_constraintStart_toStartOf="@id/cardCameraXContainer"
        app:layout_constraintEnd_toEndOf="@id/cardCameraXContainer"
        android:padding="0dp"
        android:elevation="20dp"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        app:tint="@color/primary_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
