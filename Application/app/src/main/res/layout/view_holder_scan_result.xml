<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Image de couverture du livre -->
    <ImageView
        android:id="@+id/bookCoverImage"
        android:layout_width="85dp"
        android:layout_height="125dp"
        android:contentDescription="@string/content_desc_book_cover"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:background="@drawable/border_book_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Colonne d'infos + CheckBox à droite -->
    <LinearLayout
        android:id="@+id/bookInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/bookCoverImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bookCoverImage"
        app:layout_constraintTop_toTopOf="@id/bookCoverImage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Titre du livre"
                android:textColor="@color/secondary_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/bookCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/bookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auteur(s)"
            android:textColor="@color/secondary_background"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bookPublisher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Éditeur"
            android:textColor="@color/secondary_background"
            android:textSize="14sp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
