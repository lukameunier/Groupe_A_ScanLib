<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Image de couverture du livre -->
    <ImageView
        android:id="@+id/bookCoverImage"
        android:layout_width="85dp"
        android:layout_height="125dp"
        android:contentDescription="@string/content_desc_book_cover"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:background="@drawable/border_book_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Colonne d'infos à droite -->
    <LinearLayout
        android:id="@+id/bookInfoContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/bookCoverImage"
        app:layout_constraintBottom_toBottomOf="@id/bookCoverImage"
        app:layout_constraintStart_toEndOf="@id/bookCoverImage"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titre du livre"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_background" />

        <TextView
            android:id="@+id/bookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auteur(s)"
            android:textSize="14sp"
            android:textColor="@color/secondary_background" />

        <TextView
            android:id="@+id/bookPublisher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Éditeur"
            android:textSize="14sp"
            android:textColor="@color/secondary_background" />
    </LinearLayout>
    <!-- CheckBox -->
    <CheckBox
        android:id="@+id/bookCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
