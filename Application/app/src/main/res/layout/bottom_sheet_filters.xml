<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filterPopupLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="200dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_top_rounded">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_filter_year"
        style="@style/Widget.Material3.Button.TextButton"
        android:text="@string/filtrer_par_ann_e"
        android:textColor="@color/secondary_text"
        android:backgroundTint="@color/primary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:padding="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_filter_score"
        style="@style/Widget.Material3.Button.TextButton"
        android:text="@string/filtrer_par_score"
        android:textColor="@color/secondary_text"
        android:backgroundTint="@color/primary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp" />
</LinearLayout>
